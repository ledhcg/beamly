<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>Beamly</string>
    <key>CFBundleDisplayName</key>
    <string>Beamly</string>
    <!-- Legacy identifier kept so existing installs keep their privacy permissions. -->
    <key>CFBundleIdentifier</key>
    <string>com.mac2tv.sender</string>
    <key>CFBundleExecutable</key>
    <string>Beamly</string>
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleLocalizations</key>
    <array>
        <string>en</string>
        <string>vi</string>
    </array>
    <key>CFBundleShortVersionString</key>
    <string>$(VERSION)</string>
    <key>CFBundleVersion</key>
    <string>$(BUILD_NUMBER)</string>
    <key>LSMinimumSystemVersion</key>
    <string>14.2</string>
    <key>LSUIElement</key>
    <true/>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSHumanReadableCopyright</key>
    <string>Copyright © The Beamly contributors. Licensed under the Apache License 2.0.</string>
    <key>NSLocalNetworkUsageDescription</key>
    <string>Beamly uses the local network to find your TV and stream to it.</string>
    <key>NSBonjourServices</key>
    <array>
        <string>_beamly._tcp</string>
    </array>
    <key>NSAudioCaptureUsageDescription</key>
    <string>Beamly records system audio to play it on your TV and keep the Mac's speakers silent while streaming.</string>
    <key>NSScreenCaptureUsageDescription</key>
    <string>Beamly records your screen to show it on your TV.</string>
</dict>
</plist>
